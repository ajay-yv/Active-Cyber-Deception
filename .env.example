TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=

# Use either the account auth token above, or both API key settings below.
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

TWILIO_DEFAULT_COUNTRY_CODE=91

# Brevo is the default; select "msg91" or "twilio" to use another provider.
OTP_SMS_PROVIDER=brevo

# Brevo email and SMS OTP delivery.
BREVO_API_KEY=
BREVO_EMAIL_SENDER=
BREVO_EMAIL_SENDER_NAME=Healthcare EHR Portal
BREVO_SMS_SENDER=

# MSG91 OTP API (required when OTP_SMS_PROVIDER=msg91).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Brevo is preferred for backend email OTPs when its API key and sender are set.
# Otherwise Resend (both settings) or SMTP credentials can be used.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Set to true to require an email OTP after password verification at login.
LOGIN_EMAIL_OTP_ENABLED=false

# SMTP email fallback when Brevo and Resend are unavailable.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=