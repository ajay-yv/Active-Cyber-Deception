TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=

# Use either the account auth token above, or both API key settings below.
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

TWILIO_DEFAULT_COUNTRY_CODE=91

# Resend email API (recommended) or SMTP can be used to deliver recovery codes.
# Configure a verified sender address in the selected provider.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# SMTP fallback when Resend is not configured.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=